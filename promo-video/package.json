{
  "name": "hexaview-promo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts HexaViewPromo out/still.png --frame=0",
    "render": "remotion render src/index.ts HexaViewPromo out/hexaview-master.mp4 --codec=h264 --crf=18",
    "render:cyberdockside": "remotion render src/index.ts HexaViewCyberDockside out/hexaview-cyberdockside.mp4 --codec=h264 --crf=18",
    "render:british": "remotion render src/index.ts HexaViewPromoBritish out/hexaview-master-british.mp4 --codec=h264 --crf=18",
    "render:cyberdockside:british": "remotion render src/index.ts HexaViewCyberDocksideBritish out/hexaview-cyberdockside-british.mp4 --codec=h264 --crf=18",
    "render:linkedin": "remotion render src/index.ts HexaViewLinkedInSquare \"out/HexaView LinkedIn/HexaView_LinkedIn_raw.mp4\" --codec=h264 --crf=18",
    "render:linkedin:16x9": "remotion render src/index.ts HexaViewPromo \"out/HexaView LinkedIn/HexaView_LinkedIn_16x9_raw.mp4\" --codec=h264 --crf=18"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@remotion/cli": "^4.0.506",
    "@remotion/fonts": "^4.0.506",
    "@remotion/media": "^4.0.506",
    "d3-geo": "^3.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.506",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "msedge-tts": "^2.0.9",
    "typescript": "^5.9.3"
  }
}
